#--------------------------------------------------------------------
# Plantilla de configuración. Copiarla como .env y completar.
# El .env NO se sube al repositorio (está en .gitignore).
# Qué tiene que proporcionar la institución: README.md, "Configuración institucional".
# Los valores con espacios van entre comillas (email.fromName = 'Nombre con espacios'):
# si no, CodeIgniter no arranca y todo el sitio da error 500.
#--------------------------------------------------------------------

# development en localhost; production en el servidor publicado.
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# SITIO
#--------------------------------------------------------------------

# Local: http://localhost/isgb_blog/public/   Producción: https://<dominio>/
app.baseURL = 'http://localhost/isgb_blog/public/'

# En producción, con HTTPS:
# app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# BASE DE DATOS
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = isgb_blog
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# CORREO (recuperación de contraseña)
# Sin email.fromEmail no se envían mails. En development el enlace de
# recuperación queda en writable/logs para poder probar sin servidor de correo.
#--------------------------------------------------------------------

# email.fromEmail =
# email.fromName = 'Nombre del remitente'
# email.protocol = smtp
# email.SMTPHost =
# email.SMTPPort = 587
# email.SMTPUser =
# email.SMTPPass =
# email.SMTPCrypto = tls

#--------------------------------------------------------------------
# INGRESO CON GOOGLE (opcional)
# Sin clientId y clientSecret el botón "Continuar con Google" no aparece.
#--------------------------------------------------------------------

# google.clientId =
# google.clientSecret =

# Solo cuentas de Google Workspace de este dominio (vacío = cualquier cuenta de Google).
# google.dominio =

#--------------------------------------------------------------------
# CUENTAS
#--------------------------------------------------------------------

# false = cierra el registro público de alumnos (por defecto está abierto).
# auth.registroAbierto = true
